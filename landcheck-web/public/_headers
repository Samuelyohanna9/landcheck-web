/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Keep application workspaces and tool aliases out of search indexes. The static
# shell generator supplies matching meta robots tags; this also covers responses
# served by the SPA fallback before client-side routing runs.
/green
  X-Robots-Tag: noindex, nofollow, noarchive

/green/*
  X-Robots-Tag: noindex, nofollow, noarchive

/green-work
  X-Robots-Tag: noindex, nofollow, noarchive

/green-work/*
  X-Robots-Tag: noindex, nofollow, noarchive

/dashboard
  X-Robots-Tag: noindex, nofollow, noarchive

/dashboard/*
  X-Robots-Tag: noindex, nofollow, noarchive

/admin
  X-Robots-Tag: noindex, nofollow, noarchive

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive

/estate-admin
  X-Robots-Tag: noindex, nofollow, noarchive

/estate-admin/*
  X-Robots-Tag: noindex, nofollow, noarchive

/survey-plan
  X-Robots-Tag: noindex, nofollow, noarchive

/survey-plan/*
  X-Robots-Tag: noindex, nofollow, noarchive

/hazard-analysis
  X-Robots-Tag: noindex, nofollow, noarchive

/hazard-analysis/*
  X-Robots-Tag: noindex, nofollow, noarchive

/feedback
  X-Robots-Tag: noindex, nofollow, noarchive

/feedback/*
  X-Robots-Tag: noindex, nofollow, noarchive

/app/claim
  X-Robots-Tag: noindex, nofollow, noarchive

/app/claim/*
  X-Robots-Tag: noindex, nofollow, noarchive

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Keep asset responses revalidated during deploy rollouts. The build also adds a deployment id
# to every asset filename, but this prevents a previous bad HTML response from being kept for a
# year under a JavaScript URL.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.jpeg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.mp4
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.pdf
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/green
  X-Robots-Tag: noindex, nofollow, noarchive

/green/*
  X-Robots-Tag: noindex, nofollow, noarchive

/green-work
  X-Robots-Tag: noindex, nofollow, noarchive

/green-work/*
  X-Robots-Tag: noindex, nofollow, noarchive

/dashboard
  X-Robots-Tag: noindex, nofollow, noarchive

/dashboard/*
  X-Robots-Tag: noindex, nofollow, noarchive

/admin
  X-Robots-Tag: noindex, nofollow, noarchive

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive

/estate-admin
  X-Robots-Tag: noindex, nofollow, noarchive

/estate-admin/*
  X-Robots-Tag: noindex, nofollow, noarchive

/survey-plan
  X-Robots-Tag: noindex, nofollow, noarchive

/survey-plan/*
  X-Robots-Tag: noindex, nofollow, noarchive

/hazard-analysis
  X-Robots-Tag: noindex, nofollow, noarchive

/hazard-analysis/*
  X-Robots-Tag: noindex, nofollow, noarchive

/feedback
  X-Robots-Tag: noindex, nofollow, noarchive

/feedback/*
  X-Robots-Tag: noindex, nofollow, noarchive

/app/claim
  X-Robots-Tag: noindex, nofollow, noarchive

/app/claim/*
  X-Robots-Tag: noindex, nofollow, noarchive

# Vite assets carry content hashes and a deployment id in their filenames, so they are safe to
# reuse for a long time. This avoids downloading the application bundles again on each refresh.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
